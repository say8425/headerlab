{
  "name": "headerlab",
  "version": "1.4.0",
  "private": true,
  "description": "Add, modify and remove HTTP request and response headers.",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "",
  "type": "module",
  "scripts": {
    "test": "wxt build && vitest run",
    "test:watch": "vitest",
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "wxt build --mode e2e",
    "build:bridge-e2e": "wxt build --mode bridge-e2e",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "wxt prepare && oxlint --deny-warnings",
    "lint:fix": "wxt prepare && oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "screenshots": "wxt build && node scripts/screenshots.mjs",
    "store:assets": "wxt build && node scripts/store-assets.mjs",
    "test:e2e": "wxt build --mode e2e && wxt build --mode bridge-e2e && playwright test",
    "test:packages": "pnpm -r test",
    "check:all": "pnpm check && pnpm -r test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "0.2.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "@webext-core/fake-browser": "2.0.1",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "30.0.1",
    "oxfmt": "0.60.0",
    "oxlint": "1.76.0",
    "shadcn": "4.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wxt": "0.21.1"
  },
  "packageManager": "pnpm@11.20.0"
}
